cabal-version:      3.4
name:               int-imp
version:            0.1.0.0
synopsis:           A small imperative language that compiles to x86-64
description:        An S-expression imperative language with one integer type, by-reference arguments and recursion. See SYNTAX.md.
license:            BSD-3-Clause
license-file:       LICENSE
author:             Dylan Sommer
maintainer:         dylansommer96@gmail.com
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
extra-source-files: SYNTAX.md
                    examples/*.imp
                    examples/*.out

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Ast
        Ast.Tc
        Parser
        Ssa
        AstToSsa
        Mach
        SsaToMach
        X64
        MachToX64
    build-depends:    base ^>=4.20.2.0
    hs-source-dirs:   src
    default-language: Haskell2010

executable int-imp
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.20.2.0,
        int-imp

    hs-source-dirs:   app
    default-language: Haskell2010

test-suite int-imp-test
    import:           warnings
    default-language: Haskell2010
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    build-depends:
        base ^>=4.20.2.0,
        int-imp
