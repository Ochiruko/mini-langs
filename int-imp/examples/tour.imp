(out result flag big)

(fn bump' (x)
  (set x (add x 1)))

(fn fact (n acc)
  (return (zero? n acc (fact (sub n 1) (mul n acc)))))

(fn eq3? (n)
  (return (zero? (sub n 3) 1 0)))

(fn sign-or-zero (p)
  (zero? p
    (body (return 0))
    (body (return 1))))

(fn nonzero-or-1 (n)
  (set r (zero? n 1 (body (set t (add n 0)) (return-block t))))
  (return r))

(main
  (set n 0x10)
  (set m 0b101)
  (set neg -5)
  (set e 7)
  (set d 0d7)
  (bump' n)
  (bump' 5)
  (set result (fact 5 1))
  (set s (sign-or-zero neg))
  (set q (eq3? 3))
  (set u (nonzero-or-1 0))
  (set big (mul (add n 1) (sub 0 e)))
  (zero? m (body (set flag 0)) (body (set flag 1))))
